APP_NAME=MechTech API
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

DATA_ROOT=./data
# Primary PostgreSQL production/staging configuration:
# DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/mechtech
# Local-first zero-budget development / testing fallback:
DATABASE_URL=sqlite:///./data/db/mechtech.db

SESSION_COOKIE_NAME=mechtech_session
CSRF_COOKIE_NAME=mechtech_csrf
CSRF_HEADER_NAME=X-CSRF-Token
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax

SIMULATOR_API_KEY=local-simulator-key
DEVICE_API_KEY_HEADER=X-Device-Key

READINGS_BATCH_MAX=100
READING_FUTURE_TOLERANCE_SECONDS=300
READING_QUERY_MAX_LIMIT=1000
READING_QUERY_MAX_RANGE_DAYS=31
TEMPERATURE_MIN_C=-40
TEMPERATURE_MAX_C=200
VIBRATION_MIN=-100
VIBRATION_MAX=100

STALE_DATA_THRESHOLD_SECONDS=60
ANOMALY_TEMPERATURE_WARNING_C=75
ANOMALY_TEMPERATURE_CRITICAL_C=90
ANOMALY_VIBRATION_WARNING=0.5
ANOMALY_VIBRATION_CRITICAL=0.75

FEATURE_WINDOW_SIZE=12
ANALYSIS_WINDOW_MAX=100

CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
