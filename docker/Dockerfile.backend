# Multi-stage production build for MechTech Backend
FROM python:3.12-slim AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY backend/pyproject.toml ./
RUN pip install --no-cache-dir --upgrade pip && \
    pip wheel --no-cache-dir --no-deps --wheel-dir /build/wheels -e .

# Final runtime image
FROM python:3.12-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Create non-root system user
RUN groupadd -g 1001 mechtech && \
    useradd -u 1001 -g mechtech -s /bin/bash -m mechtech

COPY backend/ /app/backend/
COPY simulator/ /app/simulator/

# Install python dependencies
RUN pip install --no-cache-dir /app/backend[production] || pip install --no-cache-dir -e /app/backend

# Create data directories with appropriate permissions
RUN mkdir -p /app/data/uploads /app/data/models /app/data/backups && \
    chown -R mechtech:mechtech /app

USER mechtech

ENV PYTHONPATH=/app/backend:/app \
    DATA_ROOT=/app/data \
    APP_ENV=production \
    PYTHONUNBUFFERED=1

EXPOSE 8000

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD curl -f http://127.0.0.1:8000/api/v1/health/live || exit 1

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "4"]

